# Copy to terraform.tfvars and fill in — terraform.tfvars is gitignored,
# never commit real values. Prefer TF_VAR_hcloud_token as an env var over
# putting the token in this file at all.

hcloud_token        = "your-hetzner-api-token"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
ssh_allowed_cidrs   = ["YOUR.IP.ADDR.ESS/32"]
server_name         = "researchquest-neo4j"
server_type         = "cpx31"
location            = "nbg1"
